{
  "name": "mysql-dsl",
  "version": "0.0.2",
  "description": "High-performance, lightweight MySQL ODM with <1μs parsing speed and advanced aggregation support.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./schema": {
      "types": "./types/schema/index.d.ts",
      "import": "./dist/esm/schema/index.js",
      "require": "./dist/cjs/schema/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json",
    "watch:build": "tsc --watch"
  },
  "keywords": [
    "mysql",
    "odm",
    "orm",
    "performance",
    "sql-builder",
    "typescript",
    "lightweight"
  ],
  "author": "吴志云",
  "license": "ISC",
  "dependencies": {
    "mysql2": "^3.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "sql-formatter": "^15.9.0",
    "tsx": "^4.23.13",
    "typescript": "^5.0.0"
  }
}
